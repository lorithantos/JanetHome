<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Janet.Core\Janet.Core.csproj" />
    <!--
      The server too, since 2026-09-03: a test enumerates its [McpServerTool] methods and holds
      each to a row in the narrowing table, and another exercises the result-budget refusal.
      It is an exe project; the .NET SDK references one like any library, and the ASP.NET Core
      framework reference flows through.
    -->
    <ProjectReference Include="..\..\src\Janet.Mcp\Janet.Mcp.csproj" />
    <!--
      And the CLI, since 2026-10-21, for its option parser. Until then nothing referenced
      Janet.Cli, so neither a test nor `dotnet test` ever compiled it, and Args.Switches (the
      set that decides whether an option swallows the next argument) had no coverage at all.
      Both exes declare a top-level-statement Program in the global namespace; that is two
      types in two assemblies and no conflict while no test names Program.
    -->
    <ProjectReference Include="..\..\src\Janet.Cli\Janet.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The frozen graphs the tests read, and the answers the original PowerShell gave for them.
      Copied beside the assembly so the tests never reach back into the repo for the live
      research.json: a test that reads the live catalog changes its own expectations every time
      someone adds a node.
    -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Goldens\**\*" CopyToOutputDirectory="PreserveNewest" />

    <!--
      One fixture is a BUILDABLE solution: a .slnx declaring no configurations, which is the
      shape that failed MSB4126 under an inherited Platform. Its source file is a fixture, not
      this project's code, so the default glob must not compile it into the test assembly.
    -->
    <Compile Remove="Fixtures\**\*.cs" />

    <!--
      The DECLARED envelope, copied live rather than frozen. Unlike the fixtures above, this
      one is meant to track the repository: the gate that validates a sample against it runs
      its sampler in build-only mode, so the entire tests section was declared and never
      checked. DotnetCheckSchemaTests reads this copy and holds the serializer to it.
    -->
    <None Include="..\..\contracts\dotnet-check.schema.json" Link="Contracts\dotnet-check.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\server-rotation.schema.json" Link="Contracts\server-rotation.schema.json" CopyToOutputDirectory="PreserveNewest" />

    <!--
      The Bicep and Azure envelopes, for the same reason and more so: a live Azure sample needs
      a sign-in and a resource group, a deployment changes that group, and one sample reaches
      one outcome. AzureSchemaTests holds every arm of each serializer to its schema here.
    -->
    <None Include="..\..\contracts\bicep-check.schema.json" Link="Contracts\bicep-check.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\azure-whatif.schema.json" Link="Contracts\azure-whatif.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\azure-deployment.schema.json" Link="Contracts\azure-deployment.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\azure-roles.schema.json" Link="Contracts\azure-roles.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\storage-probe.schema.json" Link="Contracts\storage-probe.schema.json" CopyToOutputDirectory="PreserveNewest" />

    <!--
      The assembly-api envelope: the gate's sample reads a folder that holds its dependencies,
      so siblingWarning is never in it. AssemblyApiSchemaTests emits it and holds it here.
    -->
    <None Include="..\..\contracts\assembly-api.schema.json" Link="Contracts\assembly-api.schema.json" CopyToOutputDirectory="PreserveNewest" />

    <!--
      The az-token envelope: the gate's sample needs a live sign-in and never asks for the
      token, so the token arm is held here by AzTokenSchemaTests, from a fake value.
    -->
    <None Include="..\..\contracts\az-token.schema.json" Link="Contracts\az-token.schema.json" CopyToOutputDirectory="PreserveNewest" />

    <!--
      The CLI's source, copied live as text. CliArgsTests reads every option Program.cs reads
      and holds each to Args.Switches or Args.ValueOptions, so the pin is the code itself and
      not a hand-kept list beside it that a new flag would also have to remember.
    -->
    <None Include="..\..\src\Janet.Cli\Program.cs" Link="Cli\Program.cs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
