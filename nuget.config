<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!-- Janet.Mcp.Security (the loopback guard, the DPAPI token store and the bearer check)
         is built from C:\repos\Janet.Shared and published here rather than to nuget.org.
         Relative, so it survives a clone elsewhere as long as the layout holds: this repo
         sits two levels below the folder that holds .packages (C:\repos\lorithantos\JanetHome
         against C:\repos\.packages). -->
    <add key="local" value="..\..\.packages" />
  </packageSources>
</configuration>
